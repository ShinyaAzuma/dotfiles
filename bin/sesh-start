#!/usr/bin/env bash
# tmux に入る代わりに sesh ピッカーを開くランチャー。
# bare `tmux` が作る連番セッション(0,1,...)を発生させずに、
# プロジェクトを選んだ瞬間にそのセッションを作成/復帰してアタッチする。
#
# tmux.conf の `bind o`（Ctrl+t o）と同じ挙動を、tmux の外でも使える
# 素の fzf で再現したもの。選ばなければ（ESC）素の zsh に戻る。
#
# Usage:
#   sesh-start         ピッカーを開いて選択 → 起動/復帰（選ばなければ何もしない）

set -euo pipefail

# 既に tmux 内なら何もしない（ネスト防止）
if [ -n "${TMUX:-}" ]; then
  exit 0
fi

# 依存コマンドが無ければ静かに終了（素の zsh のまま使える）
command -v sesh >/dev/null 2>&1 || exit 0
command -v fzf  >/dev/null 2>&1 || exit 0

# --- コールドスタート時の continuum 自動復元との競合を回避 ---
# その日最初のターミナルでは tmux サーバが落ちており、最初の `sesh connect` が
# サーバ起動 → continuum が前回セッションを一斉復元、という流れを引き起こす。
# 復元でサーバがビジーな最中に attach すると "Failed to attach ... exit status 1"
# になる。先にサーバを起動して復元の開始を待ち、競合窓を潰しておく。
if ! tmux info >/dev/null 2>&1; then
  tmux start-server 2>/dev/null || true
  # 復元でセッションが現れるか、最大 ~3 秒待つ（復元対象が無ければ空のまま抜ける）
  for _ in $(seq 1 15); do
    if tmux list-sessions >/dev/null 2>&1; then
      sleep 0.3   # 1つ目が現れてから残りの復元が落ち着くまで軽く待つ
      break
    fi
    sleep 0.2
  done
fi

selected=$(
  sesh list --icons | fzf \
    --no-sort --ansi --reverse --height 60% \
    --border --border-label ' sesh ' --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^x zoxide ^d kill' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
  || true
)

# 何も選ばなかった場合は素の zsh に戻る（連番セッションは作らない）
[ -z "$selected" ] && exit 0

# 復元と稀に競合して attach に失敗することがあるため数回リトライ（保険）。
# sesh connect は冪等（存在すれば接続・無ければ作成）なので再試行は安全。
for attempt in 1 2 3 4; do
  if sesh connect "$selected"; then
    exit 0
  fi
  [ "$attempt" -lt 4 ] && sleep 0.5
done

echo "sesh: セッションへの接続に失敗しました（$selected）。素の zsh に戻ります。" >&2
exit 0
