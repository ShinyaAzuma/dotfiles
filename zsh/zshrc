# === ghpr: GitHub PR/Issue 日次集計 ===
ghpr() {
  local offset=${1:-0}
  local day=$(date -v-${offset}d "+%Y-%m-%d")

  if [[ -z "${GH_WORK_USER:-}" ]]; then
    print -r -- "⚠️ GH_WORK_USER が未設定です。~/.zshrc.local で設定してください。"
    return 1
  fi

  local prev_account=$(gh api user --jq .login 2>/dev/null)
  if [[ $prev_account != "${GH_WORK_USER}" ]]; then
    gh auth switch --user "$GH_WORK_USER" >/dev/null 2>&1 || {
      print -r -- "⚠️ $GH_WORK_USER への切り替えに失敗しました。"
      return 1
    }
  fi

  print -r -- "# PR集計: $day"

  # 作業アカウントが作成 or アサインされた PR を全リポジトリ横断で検索。
  # その日に動きがあったものだけを対象: オープンは updated:$day(当日更新)、
  # マージ済みは merged-at:$day。1 リストに統合し、
  # リポジトリ単位(nameWithOwner + number)で重複排除してリポジトリ別に表示。
  {
    gh search prs --author   "$GH_WORK_USER" --state open --updated "$day" --limit 100 --json number,title,url,isDraft,repository \
      | jq -c '.[] | . + {kind: (if .isDraft then "draft" else "open" end)}'
    gh search prs --assignee "$GH_WORK_USER" --state open --updated "$day" --limit 100 --json number,title,url,isDraft,repository \
      | jq -c '.[] | . + {kind: (if .isDraft then "draft" else "open" end)}'
    gh search prs --author   "$GH_WORK_USER" --merged-at "$day" --limit 100 --json number,title,url,repository \
      | jq -c '.[] | . + {kind: "merged"}'
    gh search prs --assignee "$GH_WORK_USER" --merged-at "$day" --limit 100 --json number,title,url,repository \
      | jq -c '.[] | . + {kind: "merged"}'
  } | jq -s -r '
      unique_by([.repository.nameWithOwner, .number])
      | group_by(.repository.nameWithOwner)[]
      | "**\(.[0].repository.nameWithOwner)**",
        ( .[]
          | if   .kind == "draft"  then "- :git-pull-request-draft: #\(.number) [\(.title)](\(.url))"
            elif .kind == "merged" then "- :git-merge: #\(.number) [\(.title)](\(.url))"
            else                        "- :git-pull-request: #\(.number) [\(.title)](\(.url))" end ),
        ""
    '

  if [[ -n $prev_account && $prev_account != "${GH_WORK_USER}" ]]; then
    gh auth switch --user "$prev_account" >/dev/null 2>&1
  fi
}

# === ghprw: GitHub PR 週次集計 ===
# 引数なしで「直近7日間」を集計。第1引数に週オフセットを渡すと過去にさかのぼる
# (例: ghprw 1 → 先週の7日間)。日付範囲は GitHub 検索の "開始..終了" 構文を利用。
ghprw() {
  local offset=${1:-0}
  local end=$(date -v-$((offset * 7))d "+%Y-%m-%d")
  local start=$(date -v-$((offset * 7 + 6))d "+%Y-%m-%d")
  local range="$start..$end"

  if [[ -z "${GH_WORK_USER:-}" ]]; then
    print -r -- "⚠️ GH_WORK_USER が未設定です。~/.zshrc.local で設定してください。"
    return 1
  fi

  local prev_account=$(gh api user --jq .login 2>/dev/null)
  if [[ $prev_account != "${GH_WORK_USER}" ]]; then
    gh auth switch --user "$GH_WORK_USER" >/dev/null 2>&1 || {
      print -r -- "⚠️ $GH_WORK_USER への切り替えに失敗しました。"
      return 1
    }
  fi

  print -r -- "# PR集計: $start 〜 $end"

  # 作業アカウントが作成 or アサインされた PR を全リポジトリ横断で検索。
  # 期間中に動きがあったものを対象: オープンは updated、マージ済みは merged-at を
  # 範囲指定。1 リストに統合し、リポジトリ単位で重複排除してリポジトリ別に表示。
  {
    gh search prs --author   "$GH_WORK_USER" --state open --updated "$range" --limit 100 --json number,title,url,isDraft,repository \
      | jq -c '.[] | . + {kind: (if .isDraft then "draft" else "open" end)}'
    gh search prs --assignee "$GH_WORK_USER" --state open --updated "$range" --limit 100 --json number,title,url,isDraft,repository \
      | jq -c '.[] | . + {kind: (if .isDraft then "draft" else "open" end)}'
    gh search prs --author   "$GH_WORK_USER" --merged-at "$range" --limit 100 --json number,title,url,repository \
      | jq -c '.[] | . + {kind: "merged"}'
    gh search prs --assignee "$GH_WORK_USER" --merged-at "$range" --limit 100 --json number,title,url,repository \
      | jq -c '.[] | . + {kind: "merged"}'
  } | jq -s -r '
      unique_by([.repository.nameWithOwner, .number])
      | group_by(.repository.nameWithOwner)[]
      | "**\(.[0].repository.nameWithOwner)**",
        ( .[]
          | if   .kind == "draft"  then "- :git-pull-request-draft: #\(.number) [\(.title)](\(.url))"
            elif .kind == "merged" then "- :git-merge: #\(.number) [\(.title)](\(.url))"
            else                        "- :git-pull-request: #\(.number) [\(.title)](\(.url))" end ),
        ""
    '

  if [[ -n $prev_account && $prev_account != "${GH_WORK_USER}" ]]; then
    gh auth switch --user "$prev_account" >/dev/null 2>&1
  fi
}

