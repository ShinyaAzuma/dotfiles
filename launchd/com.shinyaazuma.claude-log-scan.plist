<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Claude Code のログに紛れ込んだ secret を毎日チェックする。

  検出するだけで書き換えない（マスクは目で確認してから手で --apply する）。
  走査に 2 分弱 CPU を使うので Nice/LowPriorityIO で後ろに回す。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shinyaazuma.claude-log-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/bin/claude-log-scan</string>
    <string>--quiet</string>
    <string>--notify</string>
  </array>

  <!-- launchd の PATH には pyenv も Homebrew も入らないので明示する -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- ログインしていない時間帯をまたいだら、次のログイン時に1度だけ走る -->
  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>

  <!-- 出力は伏せ字済みの報告のみ。secret 本体は書き出さない -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-log-scan.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-log-scan.log</string>
</dict>
</plist>
